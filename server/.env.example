# SMTP — correo institucional frate.lat
SMTP_HOST=mail.frate.lat
SMTP_PORT=587
SMTP_USER=info@frate.lat
SMTP_PASS=info

# Correo destino para notificaciones
EMAIL_TO=info@frate.lat

# Culqui — Pagos (cuando estén disponibles)
# CULQI_PUBLIC_KEY=pk_test_tu_public_key
# CULQI_SECRET_KEY=sk_test_tu_secret_key

# Token admin para dashboard (genera uno largo y único)
ADMIN_TOKEN=cambia-este-token-por-uno-seguro

# Puerto del servidor API
PORT=3001

# CORS — dominios permitidos (separados por coma)
CORS_ORIGINS=https://frate.lat,http://localhost:5173